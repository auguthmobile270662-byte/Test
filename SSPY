-- ฟังก์ชันสร้างปุ่มเมนูสไตล์ Rayfield (ฟอนต์คอมพิวเตอร์เหลี่ยม ตัวอักษรสีน้ำเงิน)
local function createButton(name, text, positionY)
   local btn = Instance.new("TextButton")
   btn.Name = name
   btn.Size = UDim2.new(0.92, 0, 0, 45)
   btn.Position = UDim2.new(0.04, 0, 0, positionY)
   btn.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
   btn.TextColor3 = Color3.fromRGB(0, 150, 255)
   btn.Text = text
   btn.TextSize = 15
   btn.Font = Enum.Font.Code
   btn.Parent = MainFrame

   local btnCorner = Instance.new("UICorner")
   btnCorner.CornerRadius = UDim.new(0, 6)
   btnCorner.Parent = btn
   
   return btn
end

-- สร้างปุ่มฟังก์ชันทั้ง 5 ตามแบบในรูป
local Btn1 = createButton("Btn1", "1. คัดลอกโค้ด", 185)
local Btn2 = createButton("Btn2", "2. รับโค้ด 1 ครั้ง", 240)
local Btn3 = createButton("Btn3", "3. บันทึกโค้ด", 295)
local Btn4 = createButton("Btn4", "4. ประวัติบันทึก", 350)
local Btn5 = createButton("Btn5", "5. รับรัวๆ: OFF", 405)

-- ตัวแปรระบบการทำงาน
local savedCodeHistory = ""
local autoRunActive = false

-- ปุ่มที่ 1: คัดลอกโค้ด
Btn1.MouseButton1Click:Connect(function()
   if setclipboard then
      setclipboard(TextBox.Text)
      Btn1.Text = "1. คัดลอกแล้ว!"
      task.wait(1)
      Btn1.Text = "1. คัดลอกโค้ด"
   else
      Btn1.Text = "1. ไม่รองรับคลิปบอร์ด"
      task.wait(1)
      Btn1.Text = "1. คัดลอกโค้ด"
   end
end)

-- ปุ่มที่ 2: รันโค้ด 1 ครั้ง
Btn2.MouseButton1Click:Connect(function()
   local success, err = pcall(function()
      local func = loadstring(TextBox.Text)
      if func then func() end
   end)
   if success then
      Btn2.Text = "2. รันสำเร็จ!"
   else
      Btn2.Text = "2. เกิดข้อผิดพลาด!"
   end
   task.wait(1)
   Btn2.Text = "2. รับโค้ด 1 ครั้ง"
end)

-- ปุ่มที่ 3: บันทึกโค้ด
Btn3.MouseButton1Click:Connect(function()
   savedCodeHistory = TextBox.Text
   Btn3.Text = "3. บันทึกแล้ว!"
   task.wait(1)
   Btn3.Text = "3. บันทึกโค้ด"
end)

-- ปุ่มที่ 4: ประวัติบันทึก (โหลดโค้ดที่เซฟไว้กลับมา)
Btn4.MouseButton1Click:Connect(function()
   if savedCodeHistory ~= "" then
      TextBox.Text = savedCodeHistory
      Btn4.Text = "4. โหลดข้อมูลแล้ว!"
   else
      Btn4.Text = "4. ไม่มีประวัติบันทึก!"
   end
   task.wait(1)
   Btn4.Text = "4. ประวัติบันทึก"
end)

-- ปุ่มที่ 5: รับรัวๆ (Auto Execute)
Btn5.MouseButton1Click:Connect(function()
   autoRunActive = not autoRunActive
   if autoRunActive then
      Btn5.Text = "5. รับรัวๆ: ON"
      Btn5.TextColor3 = Color3.fromRGB(0, 255, 100) -- เปลี่ยนเป็นสีเขียวเมื่อเปิดใช้งาน
      
      task.spawn(function()
         while autoRunActive do
            pcall(function()
               local func = loadstring(TextBox.Text)
               if func then func() end
            end)
            task.wait(0.3) -- หน่วงเวลา 0.1 วินาที
         end
      end)
   else
      Btn5.Text = "5. รับรัวๆ: OFF"
      Btn5.TextColor3 = Color3.fromRGB(0, 150, 255) -- กลับเป็นสีน้ำเงินตามธีม
   end
end)
