-- ระบบเปิด-ปิดหน้าต่างหลักผ่านปุ่มลอย
local isOpen = true
ToggleBtn.MouseButton1Click:Connect(function()
   isOpen = not isOpen
   MainFrame.Visible = isOpen
end)

-- ช่องข้อความขนาดใหญ่ (TextBox) สำหรับใส่และแก้ไขโค้ดง่ายขึ้น
local TextBox = Instance.new("TextBox")
TextBox.Size = UDim2.new(0.92, 0, 0, 120) -- ขยายช่องให้ใหญ่ขึ้น
TextBox.Position = UDim2.new(0.04, 0, 0.04, 0)
TextBox.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
TextBox.TextColor3 = Color3.fromRGB(0, 180, 255) -- ตัวอักษรสีน้ำเงินสไตล์คอมพิวเตอร์
TextBox.PlaceholderText = "วางโค้ดที่นี่..."
TextBox.Text = ""
TextBox.TextSize = 14
TextBox.Font = Enum.Font.Code -- ฟอนต์สไตล์เหลี่ยมๆ เหมือนภาษาคอมพิวเตอร์
TextBox.ClearTextOnFocus = false
TextBox.MultiLine = true
TextBox.TextXAlignment = Enum.TextXAlignment.Left
TextBox.TextYAlignment = Enum.TextYAlignment.Top
TextBox.Parent = MainFrame

local BoxCorner = Instance.new("UICorner")
BoxCorner.CornerRadius = UDim.new(0, 6)
BoxCorner.Parent = TextBox

-- ฟังก์ชันสร้างปุ่มกด (ตามแบบในรูปภาพ ต้นฉบับ)
local function createButton(name, text, color, positionY)
   local btn = Instance.new("TextButton")
   btn.Name = name
   btn.Size = UDim2.new(0.92, 0, 0, 45)
   btn.Position = UDim2.new(0.04, 0, 0, positionY)
   btn.BackgroundColor3 = color
   btn.TextColor3 = Color3.fromRGB(255, 255, 255)
   btn.Text = text
   btn.TextSize = 15
   btn.Font = Enum.Font.Code -- ใช้ฟอนต์เหลี่ยมคอมพิวเตอร์
   btn.Parent = MainFrame

   local btnCorner = Instance.new("UICorner")
   btnCorner.CornerRadius = UDim.new(0, 6)
   btnCorner.Parent = btn
   
   return btn
end

-- สร้างปุ่มทั้ง 5 ตามฟังก์ชันในรูปภาพ (ปรับตำแหน่ง Y ให้พอดีกับช่องข้อความที่ใหญ่ขึ้น)
local Btn1 = createButton("Btn1", "1. คัดลอกโค้ด", Color3.fromRGB(0, 110, 255), 175)     -- สีฟ้า
local Btn2 = createButton("Btn2", "2. รับโค้ด 1 ครั้ง", Color3.fromRGB(0, 160, 50), 230)   -- สีเขียว
local Btn3 = createButton("Btn3", "3. บันทึกโค้ด", Color3.fromRGB(70, 70, 70), 285)       -- สีเทา
local Btn4 = createButton("Btn4", "4. ประวัติบันทึก", Color3.fromRGB(120, 30, 180), 340) -- สีม่วง
local Btn5 = createButton("Btn5", "5. รับรัวๆ: OFF", Color3.fromRGB(200, 30, 30), 395)   -- สีแดง

-- ตัวแปรระบบการทำงาน
local savedCodeHistory = ""
local autoRunActive = false

-- 1. คัดลอกโค้ด
Btn1.MouseButton1Click:Connect(function()
   if setclipboard then
      setclipboard(TextBox.Text)
      Btn1.Text = "1. คัดลอกแล้ว!"
      task.wait(1)
      Btn1.Text = "1. คัดลอกโค้ด"
   else
      Btn1.Text = "1. ไม่รองรับคลิปบอร์ด!"
      task.wait(1)
      Btn1.Text = "1. คัดลอกโค้ด"
   end
end)

-- 2. รันโค้ด 1 ครั้ง
Btn2.MouseButton1Click:Connect(function()
   local success, err = pcall(function()
      local func = loadstring(TextBox.Text)
      if func then func() end
   end)
   if success then
      Btn2.Text = "2. รันสำเร็จ!"
   else
      Btn2.Text = "2. เกิดข้อผิดพลาด!"
   end
   task.wait(1)
   Btn2.Text = "2. รับโค้ด 1 ครั้ง"
end)

-- 3. บันทึกโค้ด
Btn3.MouseButton1Click:Connect(function()
   savedCodeHistory = TextBox.Text
   Btn3.Text = "3. บันทึกแล้ว!"
   task.wait(1)
   Btn3.Text = "3. บันทึกโค้ด"
end)

-- 4. ประวัติบันทึก (โหลดโค้ดที่บันทึกไว้กลับมา)
Btn4.MouseButton1Click:Connect(function()
   if savedCodeHistory ~= "" then
      TextBox.Text = savedCodeHistory
      Btn4.Text = "4. โหลดข้อมูลแล้ว!"
   else
      Btn4.Text = "4. ไม่มีประวัติบันทึก!"
   end
   task.wait(1)
   Btn4.Text = "4. ประวัติบันทึก"
end)

-- 5. รับรัวๆ (Auto Execute)
Btn5.MouseButton1Click:Connect(function()
   autoRunActive = not autoRunActive
   if autoRunActive then
      Btn5.Text = "5. รับรัวๆ: ON"
      Btn5.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
      
      task.spawn(function()
         while autoRunActive do
            pcall(function()
               local func = loadstring(TextBox.Text)
               if func then func() end
            end)
            task.wait(0.3) -- หน่วงเวลา 0.3 วินาที
         end
      end)
   else
      Btn5.Text = "5. รับรัวๆ: OFF"
      Btn5.BackgroundColor3 = Color3.fromRGB(200, 30, 30)
   end
end)
