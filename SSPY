-- ฟังก์ชันสร้างปุ่มใน ScrollingFrame
local function createMenuButton(name, text, positionY)
   local btn = Instance.new("TextButton")
   btn.Name = name
   btn.Size = UDim2.new(1, -10, 0, 40)
   btn.Position = UDim2.new(0, 0, 0, positionY)
   btn.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
   btn.TextColor3 = Color3.fromRGB(0, 150, 255)
   btn.Text = text
   btn.TextSize = 13
   btn.Font = Enum.Font.Code
   btn.Parent = ScrollingFrame

   local btnCorner = Instance.new("UICorner")
   btnCorner.CornerRadius = UDim.new(0, 6)
   btnCorner.Parent = btn
   
   return btn
end

-- สร้างปุ่มฟังก์ชันทางฝั่งขวาเรียงลงมา
local BtnCopy = createMenuButton("BtnCopy", "1. คัดลอกโค้ด", 0)
local BtnClear = createMenuButton("BtnClear", "2. เคลียร์โค้ด", 45)
local BtnRunOnce = createMenuButton("BtnRunOnce", "3. รันโค้ด 1 ครั้ง", 90)
local BtnRunAuto = createMenuButton("BtnRunAuto", "4. รัวๆ (0.1วิ): OFF", 135)
local BtnSave = createMenuButton("BtnSave", "5. บันทึกโค้ด", 180)
local BtnHistory1 = createMenuButton("BtnHistory1", "6. ประวัติบันทึก", 225)
local BtnHistory2 = createMenuButton("BtnHistory2", "7. ประวัติบันทึกโค้ด", 270)

-- ================= ระบบการทำงานของปุ่มต่างๆ =================
local savedCodeHistory = ""
local autoRunActive = false

-- 1. คัดลอกโค้ด
BtnCopy.MouseButton1Click:Connect(function()
   if setclipboard then
      setclipboard(TextBox.Text)
      BtnCopy.Text = "คัดลอกแล้ว!"
      task.wait(1)
      BtnCopy.Text = "1. คัดลอกโค้ด"
   else
      BtnCopy.Text = "ไม่รองรับคลิปบอร์ด"
      task.wait(1)
      BtnCopy.Text = "1. คัดลอกโค้ด"
   end
end)

-- 2. เคลียร์โค้ด (ลบข้อความทั้งหมดในกล่อง)
BtnClear.MouseButton1Click:Connect(function()
   TextBox.Text = ""
   BtnClear.Text = "เคลียร์แล้ว!"
   task.wait(1)
   BtnClear.Text = "2. เคลียร์โค้ด"
end)

-- 3. รันโค้ด 1 ครั้ง
BtnRunOnce.MouseButton1Click:Connect(function()
   local success = pcall(function()
      local func = loadstring(TextBox.Text)
      if func then func() end
   end)
   if success then
      BtnRunOnce.Text = "รันสำเร็จ!"
   else
      BtnRunOnce.Text = "เกิดข้อผิดพลาด!"
   end
   task.wait(1)
   BtnRunOnce.Text = "3. รันโค้ด 1 ครั้ง"
end)

-- 4. รันโค้ดรัวๆ (ความเร็ว 0.1 วิ)
BtnRunAuto.MouseButton1Click:Connect(function()
   autoRunActive = not autoRunActive
   if autoRunActive then
      BtnRunAuto.Text = "รัวๆ (0.1วิ): ON"
      BtnRunAuto.TextColor3 = Color3.fromRGB(0, 255, 100)
      
      task.spawn(function()
         while autoRunActive do
            pcall(function()
               local func = loadstring(TextBox.Text)
               if func then func() end
            end)
            task.wait(0.1) -- ความเร็ว 0.1 วินาที
         end
      end)
   else
      BtnRunAuto.Text = "4. รัวๆ (0.1วิ): OFF"
      BtnRunAuto.TextColor3 = Color3.fromRGB(0, 150, 255)
   end
end)

-- 5. บันทึกโค้ด
BtnSave.MouseButton1Click:Connect(function()
   savedCodeHistory = TextBox.Text
   BtnSave.Text = "บันทึกแล้ว!"
   task.wait(1)
   BtnSave.Text = "5. บันทึกโค้ด"
end)

-- 6 & 7. ประวัติบันทึก / ประวัติบันทึกโค้ด (โหลดโค้ดที่เซฟไว้กลับมา)
local function loadHistoryText()
   if savedCodeHistory ~= "" then
      TextBox.Text = savedCodeHistory
   end
end

BtnHistory1.MouseButton1Click:Connect(function()
   loadHistoryText()
   BtnHistory1.Text = "โหลดแล้ว!"
   task.wait(1)
   BtnHistory1.Text = "6. ประวัติบันทึก"
end)

BtnHistory2.MouseButton1Click:Connect(function()
   loadHistoryText()
   BtnHistory2.Text = "โหลดแล้ว!"
   task.wait(1)
   BtnHistory2.Text = "7. ประวัติบันทึกโค้ด"
end)
