-- ฟังก์ชันสร้างปุ่มฟังก์ชันต่างๆ
local function createMenuButton(name, text, positionY)
   local btn = Instance.new("TextButton")
   btn.Name = name
   btn.Size = UDim2.new(0.9, 0, 0, 45)
   btn.Position = UDim2.new(0.05, 0, 0, positionY)
   btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
   btn.TextColor3 = Color3.fromRGB(255, 255, 255)
   btn.Text = text
   btn.TextSize = 15
   btn.Font = Enum.Font.SourceSansBold
   btn.Parent = MainFrame

   local btnCorner = Instance.new("UICorner")
   btnCorner.CornerRadius = UDim.new(0, 8)
   btnCorner.Parent = btn
   
   return btn
end

-- สร้างปุ่มฟังก์ชันทั้ง 3
local BtnTp = createMenuButton("BtnTp", "1. คลิกเพื่อวาร์ป (Click TP): OFF", 55)
local BtnAimbot = createMenuButton("BtnAimbot", "2. เอมบอทกระสุนล็อคเป้า: OFF", 110)
local BtnWallhack = createMenuButton("BtnWallhack", "3. ทะลุกำแพง (Noclip): OFF", 165)

-- ==================== ฟังก์ชันที่ 1: คลิกเพื่อวาร์ป ====================
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local UserInputService = game:GetService("UserInputService")
local Mouse = LocalPlayer:GetMouse()

local tpEnabled = false
BtnTp.MouseButton1Click:Connect(function()
   tpEnabled = not tpEnabled
   if tpEnabled then
      BtnTp.Text = "1. คลิกเพื่อวาร์ป (Click TP): ON"
      BtnTp.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
   else
      BtnTp.Text = "1. คลิกเพื่อวาร์ป (Click TP): OFF"
      BtnTp.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
   end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
   if not gameProcessed and tpEnabled and input.UserInputType == Enum.UserInputType.MouseButton1 then
      if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or true then -- กดคลิกธรรมดาหรือใช้งานร่วมกับ Ctrl
         local char = LocalPlayer.Character
         if char and char:FindFirstChild("HumanoidRootPart") then
            if Mouse.Target then
               char.HumanoidRootPart.CFrame = CFrame.new(Mouse.Hit.Position + Vector3.new(0, 3, 0))
            end
         end
      end
   end
end)

-- ==================== ฟังก์ชันที่ 2: เอมบอทรemove กระสุนพุ่งหาเป้า ====================
local aimbotEnabled = false
BtnAimbot.MouseButton1Click:Connect(function()
   aimbotEnabled = not aimbotEnabled
   if aimbotEnabled then
      BtnAimbot.Text = "2. เอมบอทกระสุนล็อคเป้า: ON"
      BtnAimbot.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
   else
      BtnAimbot.Text = "2. เอมบอทกระสุนล็อคเป้า: OFF"
      BtnAimbot.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
   end
end)

game:GetService("RunService").RenderStepped:Connect(function()
   if aimbotEnabled then
      local camera = workspace.CurrentCamera
      local closestPlayer = nil
      local shortestDistance = math.huge
      
      -- หาผู้เล่นที่ใกล้เคียงที่สุดในจอ
      for _, player in ipairs(Players:GetPlayers()) do
         if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
               local headPos, onScreen = camera:WorldToViewportPoint(player.Character.Head.Position)
               if onScreen then
                  local mousePos = Vector2.new(Mouse.X, Mouse.Y)
                  local dist = (Vector2.new(headPos.X, headPos.Y) - mousePos).Magnitude
                  if dist < shortestDistance then
                     shortestDistance = dist
                     closestPlayer = player.Character.Head
                  end
               end
            end
         end
      end
      
      -- ล็อคมุมกล้องไปที่หัวเป้าหมายอย่างรวดเร็ว
      if closestPlayer then
         camera.CFrame = CFrame.new(camera.CFrame.Position, closestPlayer.Position)
      end
   end
end)

-- ==================== ฟังก์ชันที่ 3: ทะลุกำแพง (Noclip) ====================
local noclipEnabled = false
local noclipConnection = nil

BtnWallhack.MouseButton1Click:Connect(function()
   noclipEnabled = not noclipEnabled
   if noclipEnabled then
      BtnWallhack.Text = "3. ทะลุกำแพง (Noclip): ON"
      BtnWallhack.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
      
      noclipConnection = game:GetService("RunService").Stepped:Connect(function()
         local char = LocalPlayer.Character
         if char then
            for _, part in ipairs(char:GetDescendants()) do
               if part:IsA("BasePart") then
                  part.CanCollide = false
               end
            end
         end
      end)
   else
      BtnWallhack.Text = "3. ทะลุกำแพง (Noclip): OFF"
      BtnWallhack.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
      if noclipConnection then
         noclipConnection:Disconnect()
         noclipConnection = nil
      end
   end
end)
