-- ฟังก์ชันสร้างปุ่มใน ScrollingFrame
local function createMenuButton(name, text, positionY)
   local btn = Instance.new("TextButton")
   btn.Name = name
   btn.Size = UDim2.new(1, -10, 0, 40)
   btn.Position = UDim2.new(0, 0, 0, positionY)
   btn.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
   btn.TextColor3 = Color3.fromRGB(0, 150, 255)
   btn.Text = text
   btn.TextSize = 13
   btn.Font = Enum.Font.Code
   btn.Parent = ScrollingFrame

   local btnCorner = Instance.new("UICorner")
   btnCorner.CornerRadius = UDim.new(0, 6)
   btnCorner.Parent = btn
   
   return btn
end

-- ฟังก์ชันสร้างหัวข้อหมวดหมู่
local function createLabelHeader(text, positionY)
   local lbl = Instance.new("TextLabel")
   lbl.Size = UDim2.new(1, -10, 0, 25)
   lbl.Position = UDim2.new(0, 0, 0, positionY)
   lbl.BackgroundTransparency = 1
   lbl.Text = text
   lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
   lbl.TextSize = 13
   lbl.Font = Enum.Font.Code
   lbl.TextXAlignment = Enum.TextXAlignment.Left
   lbl.Parent = ScrollingFrame
   return lbl
end

