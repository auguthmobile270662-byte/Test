-- ฟังก์ชันสร้างปุ่มใน ScrollingFrame
local function createMenuButton(name, text, positionY)
   local btn = Instance.new("TextButton")
   btn.Name = name
   btn.Size = UDim2.new(1, -10, 0, 35)
   btn.Position = UDim2.new(0, 0, 0, positionY)
   btn.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
   btn.TextColor3 = Color3.fromRGB(0, 150, 255)
   btn.Text = text
   btn.TextSize = 13
   btn.Font = Enum.Font.Code
   btn.Parent = ScrollingFrame

   local btnCorner = Instance.new("UICorner")
   btnCorner.CornerRadius = UDim.new(0, 6)
   btnCorner.Parent = btn
   
   return btn
end

-- ฟังก์ชันสร้างหัวข้อหมวดหมู่
local function createLabelHeader(text, positionY)
   local lbl = Instance.new("TextLabel")
   lbl.Size = UDim2.new(1, -10, 0, 25)
   lbl.Position = UDim2.new(0, 0, 0, positionY)
   lbl.BackgroundTransparency = 1
   lbl.Text = text
   lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
   lbl.TextSize = 12
   lbl.Font = Enum.Font.Code
   lbl.TextXAlignment = Enum.TextXAlignment.Left
   lbl.Parent = ScrollingFrame
   return lbl
end

-- ฟังก์ชันสร้างช่องกรอกข้อความสำหรับใส่ตัวเลข
local function createInputField(name, placeholder, positionY)
   local input = Instance.new("TextBox")
   input.Name = name
   input.Size = UDim2.new(1, -10, 0, 35)
   input.Position = UDim2.new(0, 0, 0, positionY)
   input.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
   input.TextColor3 = Color3.fromRGB(0, 255, 150)
   input.PlaceholderColor3 = Color3.fromRGB(100, 100, 100)
   input.PlaceholderText = placeholder
   input.Text = ""
   input.TextSize = 13
   input.Font = Enum.Font.Code
   input.Parent = ScrollingFrame

   local corner = Instance.new("UICorner")
   corner.CornerRadius = UDim.new(0, 6)
   corner.Parent = input
   
   return input
end

